# ---- Uygulama ----
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=OftalmoAkademi

# Oturum çerezlerini ve MFA sırlarını şifrelemek için 32 bayt (base64). Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# ---- Veritabanı ----
# Geliştirme: boş bırakın -> gömülü PGlite (./data/pglite) kullanılır.
# Docker Compose ile üretim: DATABASE_URL'i boş bırakın (compose kendisi kurar), yalnızca POSTGRES_PASSWORD verin.
# Harici PostgreSQL: postgres://kullanici:sifre@host:5432/oftalmoakademi (pgvector uzantılı)
DATABASE_URL=
# Docker Compose'daki PostgreSQL parolası (uzun, rastgele; ör. openssl rand -base64 24)
POSTGRES_PASSWORD=

# ---- Dosya depolama ----
# local (./data/storage) veya s3
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Yapay zekâ ----
# Sağlayıcı yönetim panelinden seçilir (Yönetim -> Yapay zekâ ayarları). Anahtarı olan sağlayıcılar kullanılabilir.
# Google Gemini (ücretsiz katman): https://aistudio.google.com/apikey  (ücretsiz katmanda istek sınırları vardır
# ve Google, istemleri ürün geliştirme için kullanabilir; kurumsal veri koşullarını kontrol edin)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Yoğunlukta (HTTP 503) sırayla denenecek yedek modeller
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Anthropic Claude (ücretli)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Embedding (isteğe bağlı). Boşsa yalnızca tam metin arama (FTS) ile RAG çalışır.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# ---- İlk yönetici (yalnızca `npm run db:seed` için) ----
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Açılışta bekleyen migrasyonları uygula (geliştirmede PGlite için her zaman açık; üretimde tek örnek dağıtımda 1 yapın)
AUTO_MIGRATE=

# --- Makale taraması (PubMed E-utilities, ücretsiz) ---
# İsteğe bağlı API anahtarı (https://www.ncbi.nlm.nih.gov/account/ → API Key); yoksa saniyede 3 istek sınırı.
NCBI_API_KEY=
# NCBI'nin kötüye kullanım durumunda ulaşacağı kurumsal iletişim adresi (isteğe bağlı)
NCBI_EMAIL=
# 0 yapılırsa sunucu içindeki haftalık tarama zamanlayıcısı kapanır (elle "Şimdi tara" yine çalışır)
ARTICLE_SCAN_SCHEDULER=1

# ---- Demo verisi (yalnızca geliştirme: npm run db:demo) ----
# Boşsa her kurulumda rastgele parola üretilir ve ekrana bir kez yazılır.
DEMO_PASSWORD=
